{
  "name": "dsh-project-evolution",
  "version": "1.1.2",
  "description": "Project-isolated, evidence-backed engineering experience and reviewable project skills for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/**/*.md",
    "docs/**/*.png",
    "test/**/*.js",
    "scripts/**/*.mjs",
    "SECURITY.md",
    "CHANGELOG.md",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skills",
    "project-evolution",
    "experience"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test test/unit.test.js test/integration.test.js test/client.test.js",
    "acceptance": "node scripts/acceptance.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "author": "triagmas",
  "homepage": "https://github.com/triagmas/dsh-project-evolution#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triagmas/dsh-project-evolution.git"
  },
  "bugs": {
    "url": "https://github.com/triagmas/dsh-project-evolution/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
